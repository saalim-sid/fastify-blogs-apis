{
  "name": "fastify-backend-typescript",
  "version": "1.0.0",
  "description": "The nodejs backend application built on top of Fastify using Prisma and TypeScript.",
  "main": "build/server.js",
  "scripts": {
    "postinstall": "ts-node ./addons/init-project.ts",
    "start": "npm run build && npm run serve",
    "serve": "node -r dotenv/config build/server.js",
    "dev": "nodemon -r dotenv/config src/server.ts",
    "build": "npm run clean && npm run build-ts",
    "clean": "rimraf ./build",
    "build-ts": "tsc -p tsconfig.build.json",
    "watch-ts": "tsc -w -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "Saalim",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@prisma/client": "^6.4.1",
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "redis": "^4.7.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.9",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
